+/// **v1.11.7 (DarwinForge)** — `/tmp/df-pilot-mode` 읽어 모드 분기.
+/// "walklab" 이면 WalkLabBrokerage 진입, 그 외 (기본 SOCCER 모드) 는 원본 흐름.
+static bool ShouldRunWalkLabBrokerage()
+{
+    char mode[16] = {0};
+    FILE* fp = fopen("/tmp/df-pilot-mode", "r");
+    if (!fp) return false;
+    if (!fgets(mode, sizeof(mode), fp)) { fclose(fp); return false; }
+    fclose(fp);
+    // trailing newline / whitespace 제거.
+    char* nl = strchr(mode, '\n'); if (nl) *nl = 0;
+    return (strcmp(mode, "walklab") == 0);
+}
+
