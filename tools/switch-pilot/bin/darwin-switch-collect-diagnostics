#!/usr/bin/env bash
set -euo pipefail

SCRIPT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
INSTALLED_ROOT="${DARWIN_SWITCH_ROOT:-/opt/darwin-switch-agent}"
if [[ -d "${SCRIPT_ROOT}/src/darwin_switch_agent" ]]; then
  SOURCE_ROOT="${SCRIPT_ROOT}"
elif [[ -d "${INSTALLED_ROOT}/src/darwin_switch_agent" ]]; then
  SOURCE_ROOT="${INSTALLED_ROOT}"
else
  SOURCE_ROOT="${SCRIPT_ROOT}"
fi
ROOT_DIR="${DARWIN_SWITCH_ROOT:-/opt/darwin-switch-agent}"
CONFIG_PATH="${DARWIN_SWITCH_CONFIG:-/etc/darwin-switch-agent/config.json}"
OUT_DIR="${HOME:-/tmp}"
INSTALL_LOG_PATH="${DARWIN_SWITCH_INSTALL_LOG:-}"
INSTALL_KIT_DIR="${DARWIN_SWITCH_INSTALL_KIT_DIR:-}"
LAUNCHER_LOG_PATH="${DARWIN_SWITCH_COCKPIT_LOG:-}"
BOOTSTRAP_LOG_PATH="${DARWIN_SWITCH_BOOTSTRAP_LOG:-}"

usage() {
  cat <<'EOF'
Usage: darwin-switch-collect-diagnostics [--root PATH] [--config PATH] [--out-dir PATH]

Collect a read-only diagnostics bundle for a Darwin Switch install attempt.
It avoids private keys and does not send robot control commands.
EOF
}

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --root)
      [[ "$#" -ge 2 ]] || { echo "ERROR: --root needs a path" >&2; exit 2; }
      ROOT_DIR="$2"
      shift 2
      ;;
    --config)
      [[ "$#" -ge 2 ]] || { echo "ERROR: --config needs a path" >&2; exit 2; }
      CONFIG_PATH="$2"
      shift 2
      ;;
    --out-dir)
      [[ "$#" -ge 2 ]] || { echo "ERROR: --out-dir needs a path" >&2; exit 2; }
      OUT_DIR="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "ERROR: unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

mkdir -p "${OUT_DIR}"
STAMP="$(date +%Y%m%d-%H%M%S)"
WORK_DIR="$(mktemp -d)"
DEST_DIR="${WORK_DIR}/darwin-switch-diagnostics-${STAMP}"
mkdir -p "${DEST_DIR}"
trap 'rm -rf "${WORK_DIR}"' EXIT

run_capture() {
  local name="$1"
  shift
  {
    echo "+ $*"
    "$@"
  } > "${DEST_DIR}/${name}.txt" 2>&1 || true
}

write_text() {
  local name="$1"
  shift
  printf '%s\n' "$@" > "${DEST_DIR}/${name}.txt"
}

copy_if_exists() {
  local src="$1"
  local dest="$2"
  if [[ -e "${src}" ]]; then
    cp -R "${src}" "${DEST_DIR}/${dest}" 2>/dev/null || true
  fi
}

copy_file_if_exists() {
  local src="$1"
  local dest_dir="$2"
  if [[ -f "${src}" ]]; then
    mkdir -p "${DEST_DIR}/${dest_dir}"
    cp "${src}" "${DEST_DIR}/${dest_dir}/$(basename "${src}")" 2>/dev/null || true
  fi
}

write_text summary \
  "created_at=$(date -Iseconds 2>/dev/null || date)" \
  "source_root=${SOURCE_ROOT}" \
  "root=${ROOT_DIR}" \
  "config=${CONFIG_PATH}" \
  "install_kit_dir=${INSTALL_KIT_DIR:-unknown}" \
  "install_log=${INSTALL_LOG_PATH:-unknown}" \
  "bootstrap_log=${BOOTSTRAP_LOG_PATH:-unknown}" \
  "launcher_log=${LAUNCHER_LOG_PATH:-unknown}" \
  "user=${USER:-unknown}" \
  "uid=$(id -u 2>/dev/null || true)" \
  "kernel=$(uname -a 2>/dev/null || true)"

run_capture os-release sh -c 'cat /etc/os-release 2>/dev/null || true'
run_capture uname uname -a
run_capture whoami sh -c 'id; groups 2>/dev/null || true'
run_capture mounts sh -c 'findmnt 2>/dev/null || mount 2>/dev/null || true'
run_capture disk df -h
run_capture ip sh -c 'ip addr 2>/dev/null || ifconfig 2>/dev/null || true'
run_capture route sh -c 'ip route 2>/dev/null || netstat -rn 2>/dev/null || true'
run_capture resolv sh -c 'cat /etc/resolv.conf 2>/dev/null || true'
run_capture tools sh -c 'for c in python3 systemctl ssh autossh firefox firefox-esr chromium-browser chromium google-chrome xdg-open curl sha256sum shasum; do command -v "$c" || true; done'
run_capture input sh -c 'ls -l /dev/input 2>/dev/null || true; for f in /dev/input/event*; do [ -e "$f" ] && echo "$f"; done'
run_capture bluetooth sh -c 'systemctl status bluetooth --no-pager 2>/dev/null || true; bluetoothctl show 2>/dev/null || true'

if command -v systemctl >/dev/null 2>&1; then
  run_capture systemd-agent systemctl status darwin-switch-agent --no-pager
  run_capture systemd-camera systemctl status darwin-switch-camera-tunnel --no-pager
  run_capture systemd-joycond systemctl status joycond --no-pager
  run_capture systemd-enabled sh -c 'systemctl is-enabled darwin-switch-agent darwin-switch-camera-tunnel joycond 2>/dev/null || true'
fi

if command -v journalctl >/dev/null 2>&1; then
  run_capture journal-agent journalctl -u darwin-switch-agent -n 220 --no-pager
  run_capture journal-camera journalctl -u darwin-switch-camera-tunnel -n 160 --no-pager
  run_capture journal-joycond journalctl -u joycond -n 120 --no-pager
fi

PREFLIGHT_BIN=""
INPUT_CHECK_BIN=""
NETWORK_CHECK_BIN=""
NATIVE_ACCEPTANCE_BIN=""
if command -v darwin-switch-preflight >/dev/null 2>&1; then
  PREFLIGHT_BIN="$(command -v darwin-switch-preflight)"
elif [[ -x "${SOURCE_ROOT}/bin/darwin-switch-preflight" ]]; then
  PREFLIGHT_BIN="${SOURCE_ROOT}/bin/darwin-switch-preflight"
elif [[ -x "${ROOT_DIR}/bin/darwin-switch-preflight" ]]; then
  PREFLIGHT_BIN="${ROOT_DIR}/bin/darwin-switch-preflight"
fi

if [[ -n "${PREFLIGHT_BIN}" ]]; then
  run_capture preflight-human "${PREFLIGHT_BIN}" --root "${ROOT_DIR}" --config "${CONFIG_PATH}" --installed
  run_capture preflight-json "${PREFLIGHT_BIN}" --root "${ROOT_DIR}" --config "${CONFIG_PATH}" --installed --json
fi

if command -v darwin-switch-input-check >/dev/null 2>&1; then
  INPUT_CHECK_BIN="$(command -v darwin-switch-input-check)"
elif [[ -x "${SOURCE_ROOT}/bin/darwin-switch-input-check" ]]; then
  INPUT_CHECK_BIN="${SOURCE_ROOT}/bin/darwin-switch-input-check"
elif [[ -x "${ROOT_DIR}/bin/darwin-switch-input-check" ]]; then
  INPUT_CHECK_BIN="${ROOT_DIR}/bin/darwin-switch-input-check"
fi

if [[ -n "${INPUT_CHECK_BIN}" ]]; then
  run_capture input-check-human "${INPUT_CHECK_BIN}" --root "${ROOT_DIR}" --config "${CONFIG_PATH}"
  run_capture input-check-json "${INPUT_CHECK_BIN}" --root "${ROOT_DIR}" --config "${CONFIG_PATH}" --json
fi

if command -v darwin-switch-network-check >/dev/null 2>&1; then
  NETWORK_CHECK_BIN="$(command -v darwin-switch-network-check)"
elif [[ -x "${SOURCE_ROOT}/bin/darwin-switch-network-check" ]]; then
  NETWORK_CHECK_BIN="${SOURCE_ROOT}/bin/darwin-switch-network-check"
elif [[ -x "${ROOT_DIR}/bin/darwin-switch-network-check" ]]; then
  NETWORK_CHECK_BIN="${ROOT_DIR}/bin/darwin-switch-network-check"
fi

if [[ -n "${NETWORK_CHECK_BIN}" ]]; then
  run_capture network-check-human "${NETWORK_CHECK_BIN}" --root "${ROOT_DIR}" --config "${CONFIG_PATH}"
  run_capture network-check-json "${NETWORK_CHECK_BIN}" --root "${ROOT_DIR}" --config "${CONFIG_PATH}" --json
fi

if command -v darwin-switch-native-acceptance >/dev/null 2>&1; then
  NATIVE_ACCEPTANCE_BIN="$(command -v darwin-switch-native-acceptance)"
elif [[ -x "${SOURCE_ROOT}/bin/darwin-switch-native-acceptance" ]]; then
  NATIVE_ACCEPTANCE_BIN="${SOURCE_ROOT}/bin/darwin-switch-native-acceptance"
elif [[ -x "${ROOT_DIR}/bin/darwin-switch-native-acceptance" ]]; then
  NATIVE_ACCEPTANCE_BIN="${ROOT_DIR}/bin/darwin-switch-native-acceptance"
fi

if [[ -n "${NATIVE_ACCEPTANCE_BIN}" ]]; then
  run_capture native-acceptance-human "${NATIVE_ACCEPTANCE_BIN}" --config "${CONFIG_PATH}"
  run_capture native-acceptance-json "${NATIVE_ACCEPTANCE_BIN}" --config "${CONFIG_PATH}" --json
fi

run_capture cockpit-api-state python3 - <<'PY'
from __future__ import annotations

import json
import urllib.request

with urllib.request.urlopen("http://127.0.0.1:8765/api/state", timeout=2.0) as fp:
    payload = json.loads(fp.read().decode("utf-8"))
print(json.dumps(payload, ensure_ascii=False, indent=2))
PY

run_capture cockpit-api-robot-command python3 - <<'PY'
from __future__ import annotations

import json
import urllib.request

with urllib.request.urlopen("http://127.0.0.1:8765/api/robot-command", timeout=3.0) as fp:
    payload = json.loads(fp.read().decode("utf-8"))
print(json.dumps(payload, ensure_ascii=False, indent=2))
PY

if [[ -f "${CONFIG_PATH}" ]]; then
  python3 - "${CONFIG_PATH}" > "${DEST_DIR}/config-redacted.json" 2>/dev/null <<'PY' || true
from __future__ import annotations

import json
import sys
from pathlib import Path

secret_keys = {"password", "token", "secret", "identity_file", "key", "private_key"}

def redact(value):
    if isinstance(value, dict):
        out = {}
        for key, item in value.items():
            if key.lower() in secret_keys or any(part in key.lower() for part in ("password", "token", "secret", "private", "identity")):
                out[key] = "<redacted>"
            else:
                out[key] = redact(item)
        return out
    if isinstance(value, list):
        return [redact(item) for item in value]
    return value

path = Path(sys.argv[1])
print(json.dumps(redact(json.loads(path.read_text(encoding="utf-8"))), ensure_ascii=False, indent=2))
PY
fi

copy_if_exists "${ROOT_DIR}/config.example.json" "config.example.json"
copy_if_exists "${ROOT_DIR}/README.md" "runtime-README.md"
copy_if_exists "/etc/xdg/autostart/darwin-switch-cockpit.desktop" "autostart-darwin-switch-cockpit.desktop"
copy_if_exists "/etc/systemd/system/darwin-switch-agent.service" "darwin-switch-agent.service"
copy_if_exists "/etc/systemd/system/darwin-switch-camera-tunnel.service" "darwin-switch-camera-tunnel.service"

# Field-install evidence. These are text artifacts that let the Mac-side
# summarizer reconstruct which kit was used and where the one-pass flow failed.
# They intentionally avoid SSH keys and raw config secrets.
copy_file_if_exists "${INSTALL_LOG_PATH}" "install-logs"
if [[ -d "${HOME:-}" ]]; then
  while IFS= read -r _log; do
    copy_file_if_exists "${_log}" "install-logs"
  done < <(find "${HOME}" -maxdepth 1 -type f -name 'darwin-switch-install-*.log' -print 2>/dev/null | sort | tail -n 5)
fi

copy_file_if_exists "${INSTALL_KIT_DIR}/manifest.json" "install-kit"
copy_file_if_exists "$(dirname "${ROOT_DIR}")/manifest.json" "install-kit"
copy_file_if_exists "${ROOT_DIR}/../manifest.json" "install-kit"
if [[ -d "${HOME:-}" ]]; then
  while IFS= read -r _manifest; do
    copy_file_if_exists "${_manifest}" "install-kit"
  done < <(find "${HOME}" -maxdepth 3 -type f -path '*/darwin-switch-install-kit-*/manifest.json' -print 2>/dev/null | sort | tail -n 3)
fi

# Kiosk/autostart evidence. If the cockpit did not appear on first login, this
# is usually the fastest way to tell whether the agent URL was unreachable or no
# browser was available in the desktop session.
copy_file_if_exists "${BOOTSTRAP_LOG_PATH}" "bootstrap-logs"
copy_file_if_exists "${LAUNCHER_LOG_PATH}" "launcher-logs"
if [[ -d "${HOME:-}" ]]; then
  while IFS= read -r _bootstrap_log; do
    copy_file_if_exists "${_bootstrap_log}" "bootstrap-logs"
  done < <(find "${XDG_CACHE_HOME:-${HOME}/.cache}/darwin-switch-cockpit/logs" -maxdepth 1 -type f -name 'bootstrap.log*' -print 2>/dev/null | sort | tail -n 4)
  while IFS= read -r _launcher_log; do
    copy_file_if_exists "${_launcher_log}" "launcher-logs"
  done < <(find "${XDG_CACHE_HOME:-${HOME}/.cache}/darwin-switch-cockpit/logs" -maxdepth 1 -type f -name 'launcher.log*' -print 2>/dev/null | sort | tail -n 4)
  while IFS= read -r _native_launcher_log; do
    copy_file_if_exists "${_native_launcher_log}" "launcher-logs"
  done < <(find "${XDG_CACHE_HOME:-${HOME}/.cache}/darwin-switch-cockpit/logs" -maxdepth 1 -type f -name 'native-launcher.log*' -print 2>/dev/null | sort | tail -n 4)
fi

TARBALL="${OUT_DIR}/darwin-switch-diagnostics-${STAMP}.tar.gz"
tar -C "${WORK_DIR}" -czf "${TARBALL}" "$(basename "${DEST_DIR}")"
echo "${TARBALL}"
